[Unit]
Description=Aoying isolated Gotify notification service
After=network-online.target
Wants=network-online.target

[Service]
User=aoying-notify
Group=aoying-notify
WorkingDirectory=/var/lib/aoying-notify
EnvironmentFile=/etc/aoying-notify/server.env
ExecStart=/opt/aoying-monitor/bin/gotify-server
Restart=on-failure
RestartSec=5
StateDirectory=aoying-notify
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aoying-notify

[Install]
WantedBy=multi-user.target
