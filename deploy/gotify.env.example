# Generate independent credentials on the server; never use old project credentials.
GOTIFY_SERVER_LISTENADDR=127.0.0.1
GOTIFY_SERVER_PORT=18081
GOTIFY_SERVER_SECURECOOKIE=true
GOTIFY_DEFAULTUSER_NAME=aoying-admin
GOTIFY_DEFAULTUSER_PASS=REPLACE_WITH_RANDOM_SECRET
GOTIFY_DATABASE_DIALECT=sqlite3
GOTIFY_DATABASE_CONNECTION=/var/lib/aoying-notify/gotify.db
