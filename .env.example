# 复制为 .env 后填写；不要提交真实值。
# ---- 通用 ----
APP_ENV=dev
APP_NAME=aoying-monitor
APP_VERSION=0.4.0

# ---- 数据库（Docker Compose 内为 db，本机调试可用 sqlite）----
DATABASE_URL=postgresql+asyncpg://aoying:aoying@db:5432/aoying
POSTGRES_USER=aoying
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aoying

# ---- 认证 ----
# 留空则首次启动随机生成管理员密码并打印到容器日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
WS_TICKET_TTL_SECONDS=60

# ---- Web ----
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SITE_ADDRESS=

# ---- Telegram ----
TG_API_ID=
TG_API_HASH=
# 会话文件与媒体落盘位置（Docker 内映射到 ./data 卷）
TG_SESSION_PATH=/data/telegram.session
TG_MEDIA_DIR=/data/media
# 每个群首次回补多少条、补洞间隔秒数（0 关闭定时补洞）
TG_BACKFILL_LIMIT=200
TG_SYNC_INTERVAL_SECONDS=300
# 服务启动时自动拉起采集器；首次登录前保持 false
TG_AUTO_START=false

# ---- OKX 只读 ----
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---- 跟单（Bitget 只读）----
# 影子阶段用 COPY_EQUITY_USDT 代替真实权益；一旦填了下面三个值，
# 定标改用 Bitget USDT-FUTURES 账户的 accountEquity，这个常数被忽略。
COPY_MODE=shadow
COPY_EQUITY_USDT=1000
COPY_PAUSED=false
# 权限只勾「合约交易」，永久关闭提现，并绑服务器 IP 白名单。
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=

# ---- fomo（仅一次性解析钱包）----
FOMO_API_KEY=
FOMO_HANDLE=
SOLANA_RPC_URL=
BASE_RPC_URL=

# ---- X ----
X_COOKIES_PATH=/data/x/cookies.json
X_TARGET_HANDLE=

# ---- LLM ----
DEEPSEEK_API_KEY=
QWEN_VL_API_KEY=

# ---- 兜底通知 ----
WECOM_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
