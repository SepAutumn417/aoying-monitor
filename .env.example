# 复制为 .env 后填写；不要提交真实值。
# ---- 通用 ----
APP_ENV=dev
APP_NAME=aoying-monitor
APP_VERSION=0.1.0

# ---- 数据库（Docker Compose 内为 db，本机调试为 127.0.0.1）----
DATABASE_URL=postgresql+asyncpg://aoying:aoying@db:5432/aoying
POSTGRES_USER=aoying
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aoying

# ---- 认证 ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720

# ---- Web ----
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Telegram（I2）----
TG_API_ID=
TG_API_HASH=
TG_SESSION_DIR=/data/tg
TG_GROUP_IDS=

# ---- OKX 只读（I4）----
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---- fomo（I5，仅一次性解析钱包）----
FOMO_API_KEY=
SOLANA_RPC_URL=
BASE_RPC_URL=

# ---- X（I6）----
X_COOKIES_PATH=/data/x/cookies.json
X_TARGET_HANDLE=thankUcrypto_

# ---- LLM（I3）----
DEEPSEEK_API_KEY=
QWEN_VL_API_KEY=

# ---- 兜底通知（I7）----
WECOM_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
