# 复制为 .env 后填写；不要提交真实值。
# ---- 通用 ----
APP_ENV=dev
APP_NAME=aoying-monitor
APP_VERSION=0.2.0

# ---- 数据库（Docker Compose 内为 db，本机调试可用 sqlite）----
DATABASE_URL=postgresql+asyncpg://aoying:aoying@db:5432/aoying
POSTGRES_USER=aoying
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aoying

# ---- 认证 ----
# 留空则首次启动随机生成管理员密码并打印到容器日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
WS_TICKET_TTL_SECONDS=60

# ---- Web ----
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SITE_ADDRESS=

# ---- Telegram ----
TG_API_ID=
TG_API_HASH=
TG_SESSION_DIR=/data/tg
TG_GROUP_IDS=

# ---- OKX 只读 ----
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---- fomo（仅一次性解析钱包）----
FOMO_API_KEY=
FOMO_HANDLE=
SOLANA_RPC_URL=
BASE_RPC_URL=

# ---- X ----
X_COOKIES_PATH=/data/x/cookies.json
X_TARGET_HANDLE=

# ---- LLM ----
DEEPSEEK_API_KEY=
QWEN_VL_API_KEY=

# ---- 兜底通知 ----
WECOM_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
